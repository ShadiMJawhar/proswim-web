<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the V27_WEB application (copied into dist/ by vite).

  The portal is a single-page app: only /V27_WEB/index.html exists on disk, so
  deep links and refreshes on client routes (e.g. /V27_WEB/students) must be
  rewritten to it or IIS returns 404. Requires the URL Rewrite module.

  Caching (2026-11-02): index.html, and every route rewritten to it, must be
  revalidated on each load (Cache-Control: no-cache). Without it browsers kept
  a heuristically cached copy that pointed at the previous upload's hashed
  assets/index-*.js, and a deep link opened in a new tab showed a blank page
  until a refresh. The hashed files under assets/ never change, so they get a
  one-year max-age instead.
-->
<configuration>
  <!--
    This app is a child of the legacy admin.proswim-lb.com site and inherits its
    web.config, which registers classic-ASP.NET HTTP modules (QueryStringModule
    and friends) whose assemblies live in the parent's bin\. A static SPA has no
    bin\, so IIS fails with "Could not load type 'QueryStringModule'".
    Clearing the inherited managed modules is what makes the child app standalone.
    If another inherited module surfaces, add a matching <remove /> below.
  -->
  <system.web>
    <httpModules>
      <clear />
    </httpModules>
  </system.web>
  <system.webServer>
    <modules>
      <remove name="QueryStringModule" />
    </modules>
    <!-- Note: do NOT <clear /> <handlers> here. Replacing them with a lone
         StaticFile entry made IIS return 200 with an empty body and no
         Content-Type. The No Managed Code app pool already prevents the
         parent site's managed handlers from loading. -->
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <!-- IIS has no default mapping for these; without them they 404. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Everything (index.html, rewritten routes, web manifest, icons) is
           revalidated on each load; assets/ is overridden below. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- Content-hashed build output: a new build gets new file names, so these
       can be cached for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
